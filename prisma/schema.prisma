generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  READY
  PARAMETRIC
  PRINT_TEMPLATE
}

enum PublicationStatus {
  DRAFT
  REVIEW
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum ModelFileStatus {
  UPLOADED
  ANALYZED
  NEEDS_REVIEW
  REJECTED
  APPROVED
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  ESTIMATING
  APPROVED
  AWAITING_PAYMENT
  PAID
  QUEUED
  PRINTING
  POST_PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  CANCELED
  REFUNDED
  FAILED
}

// Reversible removal from the internal client directory, not account erasure.
model ClientArchive {
  key       String   @id
  createdAt DateTime @default(now())
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  passwordHash  String
  name          String?
  phone         String?
  company       String?
  taxId         String?
  isActive      Boolean             @default(true)
  twoFactorKey  String?
  emailVerified DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  lastActiveAt  DateTime            @default(now())
  lastVisitedAt DateTime?
  roles         UserRole[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  modelFiles    CustomerModelFile[]
  favorites     ProductFavorite[]
  reviews       Review[]
  auditLogs     AuditLog[]          @relation("AuditActor")
  privacyConsents PrivacyConsent[]
  privacyRequests PrivacyRequest[]
  socialAccounts SocialAccount[]
  oauthAttempts OAuthAttempt[]
  adminLoginChallenges AdminLoginChallenge[]
}

// Daily public-page totals only. No event rows, precise times or visitor keys.
model MonitoringCounter {
  day       DateTime @db.Date
  path      String
  productId String?
  views     BigInt   @default(0)

  @@id([day, path])
  @@index([day])
}

model SocialAccount {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  clientId  String
  subject   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, clientId, subject])
  @@unique([userId, provider, clientId])
}

// Ten-minute, browser-bound authorization attempts. Tokens are never persisted.
model OAuthAttempt {
  id             String   @id @default(cuid())
  provider       String
  stateHash      String   @unique
  bindingHash    String   @unique
  configRevision String
  verifier       String
  nonce          String
  returnTo       String
  stage          String   @default("STARTED")
  profile        String?
  consent        Json
  linkUserId     String?
  sessionHash    String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [linkUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PrivacyConsent {
  id          String   @id @default(cuid())
  userId      String?
  orderId     String?
  subjectHash String
  purpose     String
  version     String
  document    Json
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  review      Review?
  reviewAiJob ReviewAiJob?

  @@index([userId, createdAt])
  @@index([purpose, expiresAt])
}

model PrivacyRequest {
  id          String   @id @default(cuid())
  userId      String
  type        String
  message     String
  status      String   @default("OPEN")
  response    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?
  adminVerifiedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AdminLoginChallenge {
  id String @id @default(cuid())
  tokenHash String @unique
  bindingHash String
  userId String
  email String
  passwordFingerprint String
  returnTo String
  purpose String @default("login")
  sessionHash String?
  smtpRevision String?
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  city       String
  postalCode String
  street     String
  apartment  String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  parentId        String?
  descriptionTop  String?
  description     String?
  image           String?
  title           String?
  metaDescription String?
  h1              String?
  canonical       String?
  robots          String            @default("index,follow")
  visible         Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  parent          Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]        @relation("CategoryTree")
  products        ProductCategory[]
  seoFilters      SeoFilter[]
}

model Product {
  id               String              @id @default(cuid())
  name             String
  slug             String              @unique
  sku              String              @unique
  type             ProductType         @default(READY)
  status           PublicationStatus   @default(DRAFT)
  badge            String?
  shortDescription String?
  description      String?
  usage            String?
  instructions     String?
  specifications   Json?
  catalogFacets    CatalogFacet[]
  catalogFacetVersion Int @default(0)
  categoryMode     String              @default("MANUAL")
  categoryAiJob    ProductCategoryAiJob?
  basePrice        Decimal             @db.Decimal(12, 2)
  oldPrice         Decimal?            @db.Decimal(12, 2)
  costPrice        Decimal?            @db.Decimal(12, 2)
  stock            Int                 @default(0)
  reservedStock    Int                 @default(0)
  madeToOrder      Boolean             @default(true)
  leadDays         Int                 @default(3)
  weightGrams      Decimal?            @db.Decimal(12, 3)
  widthMm          Decimal?            @db.Decimal(12, 3)
  heightMm         Decimal?            @db.Decimal(12, 3)
  depthMm          Decimal?            @db.Decimal(12, 3)
  shippingWeightG  Int?
  shippingLengthMm Int?
  shippingWidthMm  Int?
  shippingHeightMm Int?
  modelAsset       String?
  title            String?
  metaDescription  String?
  h1               String?
  canonical        String?
  robots           String              @default("index,follow")
  publishedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  categories       ProductCategory[]
  images           ProductImage[]
  variants         ProductVariant[]
  materials        Material[]
  colors           Color[]
  // Retired manufacturing relations: retained only for legacy data compatibility.
  technologies     Technology[]
  qualityProfiles  QualityProfile[]
  postProcesses    PostProcessOption[]
  reviews          Review[]
  favorites        ProductFavorite[]
  cartItems        CartItem[]
  cartStockHolds   CartStockHoldItem[]
  orderItems       OrderItem[]
  marketplaceMode  String              @default("AUTO")
  marketplaceListings MarketplaceListing[]
  marketplaceIdentities MarketplaceIdentity[]
  groupId          String?
  group            ProductGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupLabel       String?
  groupingMode     String @default("AUTO")

  @@index([groupId])
  @@index([status, publishedAt])
  @@index([basePrice])
  @@index([catalogFacetVersion, id])
}

// Presentation only: each member keeps its own identity, inventory and orders.
model CatalogFacet {
  id String @id @default(cuid())
  kind String
  slug String
  name String
  products Product[]
  @@unique([kind, slug])
}

model ProductGroup {
  id        String @id @default(cuid())
  name      String
  sourceKey String? @unique
  products  Product[]
}

// Stable cross-marketplace identities. Names alone are never sufficient to merge.
model MarketplaceIdentity {
  key       String  @id
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}

model MarketplaceListing {
  id          String   @id @default(cuid())
  provider    String
  accountId   String
  externalId  String
  sellerSku   String
  normalizedSku String
  barcodes    String[]
  snapshot    Json
  productId   String?
  conflict    String?
  lastRunId   String?
  updatedAt   DateTime @updatedAt
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@unique([provider, accountId, externalId])
  @@unique([provider, accountId, productId])
  @@index([normalizedSku])
  @@index([productId])
  @@index([conflict])
}

// A durable, explicitly requested import. No scheduled marketplace writes.
model MarketplaceSyncRun {
  id          String   @id @default(cuid())
  provider    String
  accountId   String
  status      String   @default("QUEUED")
  actorId     String?
  cursor      Json?
  processed   Int      @default(0)
  created     Int      @default(0)
  updated     Int      @default(0)
  conflicts   Int      @default(0)
  error       String?
  leaseToken  String?
  leaseUntil  DateTime?
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  @@index([status, createdAt])
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  path      String
  alt       String
  caption   String?
  sortOrder Int     @default(0)
  width     Int?
  height    Int?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Material {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  type            String
  density         Decimal          @db.Decimal(8, 4)
  pricePerGram    Decimal          @db.Decimal(10, 2)
  description     String?
  advantages      String?
  disadvantages   String?
  temperature     String?
  image           String?
  title           String?
  metaDescription String?
  active          Boolean          @default(true)
  products        Product[]
  colors          Color[]
  variants        ProductVariant[]
  orderItems      OrderItem[]
}

model Color {
  id         String           @id @default(cuid())
  name       String
  slug       String           @unique
  hex        String
  image      String?
  stock      Decimal?         @db.Decimal(12, 2)
  active     Boolean          @default(true)
  materials  Material[]
  products   Product[]
  variants   ProductVariant[]
  orderItems OrderItem[]
}

// Retired dictionaries. No current UI, catalog actions or purchase pricing uses them.
// Preserve referenced historical orders rather than dropping their foreign keys.
model Technology {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  description     String?
  accuracy        String?
  applications    String?
  image           String?
  title           String?
  metaDescription String?
  active          Boolean     @default(true)
  products        Product[]
  orderItems      OrderItem[]
}

model QualityProfile {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  layerHeightMm   Decimal          @db.Decimal(5, 3)
  speedMultiplier Decimal          @default(1) @db.Decimal(6, 3)
  priceMultiplier Decimal          @default(1) @db.Decimal(6, 3)
  description     String?
  active          Boolean          @default(true)
  products        Product[]
  variants        ProductVariant[]
  orderItems      OrderItem[]
}

model PostProcessOption {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  price       Decimal   @db.Decimal(10, 2)
  leadDays    Int       @default(0)
  description String?
  active      Boolean   @default(true)
  products    Product[]
}

model ProductVariant {
  id               String          @id @default(cuid())
  productId        String
  materialId       String?
  colorId          String?
  qualityProfileId String?
  sku              String          @unique
  price            Decimal         @db.Decimal(12, 2)
  stock            Int             @default(0)
  active           Boolean         @default(true)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  material         Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  color            Color?          @relation(fields: [colorId], references: [id], onDelete: SetNull)
  qualityProfile   QualityProfile? @relation(fields: [qualityProfileId], references: [id], onDelete: SetNull)
  cartItems        CartItem[]
  orderItems       OrderItem[]

  @@index([productId, active])
}

model CustomerModelFile {
  id           String          @id @default(cuid())
  ownerId      String?
  guestKey     String?
  originalName String
  storedName   String          @unique
  extension    String
  mimeType     String
  sizeBytes    BigInt
  sha256       String
  widthMm      Decimal?        @db.Decimal(12, 3)
  heightMm     Decimal?        @db.Decimal(12, 3)
  depthMm      Decimal?        @db.Decimal(12, 3)
  volumeCm3    Decimal?        @db.Decimal(14, 4)
  watertight   Boolean?
  status       ModelFileStatus @default(UPLOADED)
  analysisNote String?
  createdAt    DateTime        @default(now())
  owner        User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@unique([ownerId, sha256])
  @@index([ownerId, createdAt])
  @@index([guestKey, createdAt])
}

model PriceRule {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  value       Decimal  @db.Decimal(14, 4)
  unit        String
  active      Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  sessionKey String?    @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
  stockHold  CartStockHold?
  checkoutOrders Order[] @relation("CheckoutCart")
}

// A hold survives cart deletion until the worker releases its stock.
model CartStockHold {
  id        String              @id @default(cuid())
  cartId    String?             @unique
  expiresAt DateTime
  cart      Cart?               @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items     CartStockHoldItem[]

  @@index([expiresAt])
}

model CartStockHoldItem {
  id        String        @id @default(cuid())
  holdId    String
  productId String
  quantity  Int
  hold      CartStockHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([holdId, productId])
  @@index([productId])
}

model CartItem {
  id          String             @id @default(cuid())
  cartId      String
  productId   String?
  variantId   String?
  modelFileId String?
  returnedOrderItemId String? @unique
  quantity    Int                @default(1)
  unitPrice   Decimal            @db.Decimal(12, 2)
  config      Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  cart        Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  modelFile   CustomerModelFile? @relation(fields: [modelFileId], references: [id], onDelete: SetNull)
  returnedOrderItem OrderItem? @relation("ReturnedOrderItem", fields: [returnedOrderItemId], references: [id], onDelete: SetNull)
}

model Order {
  id              String              @id @default(cuid())
  number          String              @unique
  userId          String?
  status          OrderStatus         @default(NEW)
  statusChangedAt DateTime?
  kind            String              @default("ORDER")
  inventoryTracked Boolean            @default(false)
  reservationExpiresAt DateTime?
  reservationExpiredAt DateTime?
  checkoutCartId String?
  cartRestoredAt DateTime?
  stockReviewRequired Boolean         @default(false)
  deletedAt       DateTime?
  personalDataErasedAt DateTime?
  privacyClosedAt DateTime?
  retentionHoldUntil DateTime?
  retentionHoldReason String?
  purchaseConfirmedAt DateTime?
  customerName    String
  customerEmail   String
  customerPhone   String
  company         String?
  shippingAddress String?
  customerComment String?
  internalNote    String?
  subtotal        Decimal             @db.Decimal(12, 2)
  deliveryPrice   Decimal             @default(0) @db.Decimal(12, 2)
  discount        Decimal             @default(0) @db.Decimal(12, 2)
  total           Decimal             @db.Decimal(12, 2)
  currency        String              @default("RUB")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  checkoutCart    Cart?               @relation("CheckoutCart", fields: [checkoutCartId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payment         Payment?
  shipment        Shipment?
  notifications   OrderNotification[]
  telegramJob     TelegramOrderJob?
  telegramStatusJobs TelegramOrderStatusJob[]
  fiscalReceipts   FiscalReceipt[]
  yookassaSettlement YooKassaSettlement?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([deletedAt, status, createdAt])
  @@index([privacyClosedAt])
  @@index([reservationExpiresAt])
  @@index([checkoutCartId])
}

// Restricted technical evidence, not a substitute for the operator's signed act.
// Plans contain existing record IDs/managed filenames, never contact values.
model PrivacyErasure {
  id String @id @default(uuid())
  subjectHash String
  reason String
  plan Json
  retainedUntil DateTime?
  filesRemovedAt DateTime?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([filesRemovedAt])
}

model OrderItem {
  id               String             @id @default(cuid())
  orderId          String
  productId        String?
  variantId        String?
  modelFileId      String?
  materialId       String?
  colorId          String?
  technologyId     String?
  qualityProfileId String?
  productName      String
  groupLabel       String?
  productColor     String?
  sku              String?
  quantity         Int                @default(1)
  reservedStock    Int                @default(0)
  stockReservationState String         @default("NONE")
  unitPrice        Decimal            @db.Decimal(12, 2)
  totalPrice       Decimal            @db.Decimal(12, 2)
  configuration    Json?
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant          ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnedCartItem CartItem? @relation("ReturnedOrderItem")
  modelFile        CustomerModelFile? @relation(fields: [modelFileId], references: [id], onDelete: SetNull)
  material         Material?          @relation(fields: [materialId], references: [id], onDelete: SetNull)
  color            Color?             @relation(fields: [colorId], references: [id], onDelete: SetNull)
  technology       Technology?        @relation(fields: [technologyId], references: [id], onDelete: SetNull)
  qualityProfile   QualityProfile?    @relation(fields: [qualityProfileId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String        @unique
  provider   String
  externalId String?       @unique
  status     PaymentStatus @default(PENDING)
  amount     Decimal       @db.Decimal(12, 2)
  payload    Json?
  paidAt     DateTime?
  refundReviewRequired Boolean @default(false)
  updatedAt  DateTime      @updatedAt
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model FiscalReceipt {
  id              String   @id @default(cuid())
  orderId         String
  kind            String
  status          String   @default("WAITING_PAYMENT")
  publicId        String
  inn             String
  request         String
  externalId      String?  @unique
  requestId       String   @unique @default(uuid())
  amount          Decimal  @db.Decimal(12, 2)
  firstAttemptAt  DateTime?
  nextAttemptAt   DateTime @default(now())
  leaseUntil      DateTime?
  attempts        Int      @default(0)
  errorCode       String?
  receiptUrl      String?
  fiscalData      Json?
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, kind])
  @@index([status, nextAttemptAt])
}

// One durable, idempotent prepayment-settlement receipt for a YooKassa order.
model YooKassaSettlement {
  id String @id @default(uuid())
  orderId String @unique
  paymentId String
  shopId String
  request String
  status String @default("PENDING")
  externalId String? @unique
  firstAttemptAt DateTime?
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  attempts Int @default(0)
  errorCode String?
  processedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
}

model Shipment {
  id          String    @id @default(cuid())
  orderId     String    @unique
  provider    String
  method      String
  tracking    String?
  cost        Decimal   @default(0) @db.Decimal(12, 2)
  payload     Json?
  shippedAt   DateTime?
  deliveredAt DateTime?
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ozonJob     OzonDeliveryJob?
  cdekJob     CdekDeliveryJob?
}

model CdekDeliveryJob {
  id String @id @default(cuid())
  shipmentId String @unique
  environment String
  clientId String
  request Json
  remoteId String? @unique
  status String @default("PENDING")
  deliveryStatus String?
  deliveryStatusChangedAt DateTime?
  error String?
  attempts Int @default(0)
  lockedUntil DateTime?
  lockToken String?
  nextAttemptAt DateTime @default(now())
  cancelRequestedAt DateTime?
  updatedAt DateTime @updatedAt
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  @@index([status, nextAttemptAt])
  @@index([cancelRequestedAt, nextAttemptAt])
}

model OzonDeliveryJob {
  id             String    @id @default(cuid())
  shipmentId     String    @unique
  clientId       String
  idempotencyKey String    @unique @default(uuid())
  request        Json
  response       Json?
  status         String    @default("PENDING")
  error          String?
  attempts       Int       @default(0)
  lockedUntil    DateTime?
  lockToken      String?
  nextAttemptAt  DateTime  @default(now())
  cancelRequestedAt DateTime?
  cancelError    String?
  updatedAt      DateTime  @updatedAt
  shipment       Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([cancelRequestedAt, nextAttemptAt])
}

model OzonDeliveryPoint {
  id             String    @id
  name           String
  address        String
  type           String
  active         Boolean   @default(true)
  clientId       String
  methodId       BigInt
  generation     String
  latitude       Float?
  longitude      Float?
  updatedAt      DateTime  @updatedAt

  @@index([clientId, methodId, active])
}

model OzonDeliverySync {
  id          String    @id @default("ozon")
  clientId    String
  methodId    BigInt
  generation  String    @default(uuid())
  cursor      String?
  status      String    @default("PENDING")
  pages       Int       @default(0)
  points      Int       @default(0)
  error       String?
  lockedUntil DateTime?
  lockToken   String?
  updatedAt   DateTime  @updatedAt
}

model OrderNotification {
  id        String    @id @default(cuid())
  orderId   String
  channel   String
  recipient String
  template  String
  status    String
  sentAt    DateTime?
  error     String?
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Rubric {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  articles    Article[]
}

model Article {
  id              String            @id @default(cuid())
  rubricId        String
  title           String
  slug            String            @unique
  excerpt         String?
  content         String
  cover           String?
  authorName      String?
  status          PublicationStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  h1              String?
  canonical       String?
  robots          String            @default("index,follow")
  publishedAt     DateTime?
  updatedAt       DateTime          @updatedAt
  createdAt       DateTime          @default(now())
  rubric          Rubric            @relation(fields: [rubricId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
}

model FaqItem {
  id        String   @id @default(cuid())
  scope     String   @default("general")
  scopeId   String?
  question  String
  answer    String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([scope, scopeId, active])
}

model SeoPage {
  id              String   @id @default(cuid())
  path            String   @unique
  title           String
  metaDescription String
  h1              String
  canonical       String?
  robots          String   @default("index,follow")
  ogImage         String?
  schemaTypes     String[]
  content         String?
  updatedAt       DateTime @updatedAt
}

model SeoFilter {
  id              String   @id @default(cuid())
  categoryId      String
  slug            String
  filter          Json
  title           String
  metaDescription String
  h1              String
  content         String?
  canonical       String?
  active          Boolean  @default(true)
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  code      Int      @default(301)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MetaTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  scope       String
  title       String
  description String
  h1          String
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  rating    Int
  author    String
  text      String
  approved  Boolean  @default(false)
  status    String   @default("PENDING")
  // Nullable unique key preserves historical reviews without rewriting them.
  buyerKey  String?  @unique
  verifiedPurchase Boolean @default(false)
  consentId String? @unique
  consent PrivacyConsent? @relation(fields: [consentId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  images    ReviewImage[]
  aiJob     ReviewAiJob?

  @@index([productId, approved, createdAt])
}

model ReviewAiJob {
  reviewId    String   @id
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  consentId   String?  @unique
  // Separate optional consent; checked again before any transfer/publication.
  consent     PrivacyConsent? @relation(fields: [consentId], references: [id], onDelete: SetNull)
  status      String   @default("PENDING")
  reason      String?
  attempts    Int      @default(0)
  leaseToken  String?
  leaseUntil  DateTime?
  availableAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, availableAt])
}

model TelegramOrderJob {
  orderId     String   @id
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  revision    String
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  errorCode   String?
  leaseToken  String?
  leaseUntil  DateTime?
  availableAt DateTime @default(now())
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, availableAt])
}

model TelegramOrderStatusJob {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind        String
  revision    String
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  errorCode   String?
  leaseToken  String?
  leaseUntil  DateTime?
  availableAt DateTime @default(now())
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orderId, kind])
  @@index([status, availableAt])
}

model ReviewImage {
  id        String @id @default(cuid())
  reviewId  String
  fileName  String @unique
  width     Int
  height    Int
  sortOrder Int @default(0)
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, sortOrder])
}

model ProductFavorite {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model DeliveryMethod {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  basePrice   Decimal @default(0) @db.Decimal(10, 2)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
  deletedAt   DateTime?
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  group     String   @default("general")
  label     String?
  updatedAt DateTime @updatedAt
}

// Durable, bounded AI queue. Product content is read at execution, not copied
// into logs or job payloads. Existing products retain manual categories.
model ProductCategoryAiJob {
  productId   String   @id
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING")
  generation  Int      @default(1)
  attempts    Int      @default(0)
  leaseToken  String?
  leaseUntil  DateTime?
  availableAt DateTime @default(now())
  errorCode   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, availableAt])
}

// Operational diagnostics only. No request/response bodies, credentials or buyer data.
model DiagnosticLog {
  id        String   @id @default(cuid())
  reference String   @unique
  level     String
  area      String
  code      String
  details   Json
  createdAt DateTime @default(now())

  @@index([createdAt, id])
  @@index([area, level, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
model GuestOrderGrant {
  tokenHash   String   @id
  orderNumber String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([orderNumber])
  @@index([expiresAt])
}

