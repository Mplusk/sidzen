generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  READY
  PARAMETRIC
  PRINT_TEMPLATE
}

enum PublicationStatus {
  DRAFT
  REVIEW
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum ModelFileStatus {
  UPLOADED
  ANALYZED
  NEEDS_REVIEW
  REJECTED
  APPROVED
}

enum OrderStatus {
  NEW
  ESTIMATING
  APPROVED
  AWAITING_PAYMENT
  PAID
  QUEUED
  PRINTING
  POST_PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  CANCELED
  REFUNDED
  FAILED
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  passwordHash  String
  name          String?
  phone         String?
  company       String?
  taxId         String?
  isActive      Boolean             @default(true)
  twoFactorKey  String?
  emailVerified DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  roles         UserRole[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  modelFiles    CustomerModelFile[]
  favorites     ProductFavorite[]
  reviews       Review[]
  auditLogs     AuditLog[]          @relation("AuditActor")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  city       String
  postalCode String
  street     String
  apartment  String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  parentId        String?
  descriptionTop  String?
  description     String?
  image           String?
  title           String?
  metaDescription String?
  h1              String?
  canonical       String?
  robots          String            @default("index,follow")
  visible         Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  parent          Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]        @relation("CategoryTree")
  products        ProductCategory[]
  seoFilters      SeoFilter[]
}

model Product {
  id               String              @id @default(cuid())
  name             String
  slug             String              @unique
  sku              String              @unique
  type             ProductType         @default(READY)
  status           PublicationStatus   @default(DRAFT)
  badge            String?
  shortDescription String?
  description      String?
  usage            String?
  instructions     String?
  specifications   Json?
  basePrice        Decimal             @db.Decimal(12, 2)
  oldPrice         Decimal?            @db.Decimal(12, 2)
  costPrice        Decimal?            @db.Decimal(12, 2)
  stock            Int                 @default(0)
  madeToOrder      Boolean             @default(true)
  leadDays         Int                 @default(3)
  weightGrams      Decimal?            @db.Decimal(12, 3)
  widthMm          Decimal?            @db.Decimal(12, 3)
  heightMm         Decimal?            @db.Decimal(12, 3)
  depthMm          Decimal?            @db.Decimal(12, 3)
  modelAsset       String?
  title            String?
  metaDescription  String?
  h1               String?
  canonical        String?
  robots           String              @default("index,follow")
  publishedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  categories       ProductCategory[]
  images           ProductImage[]
  variants         ProductVariant[]
  materials        Material[]
  colors           Color[]
  technologies     Technology[]
  qualityProfiles  QualityProfile[]
  postProcesses    PostProcessOption[]
  reviews          Review[]
  favorites        ProductFavorite[]
  cartItems        CartItem[]
  orderItems       OrderItem[]

  @@index([status, publishedAt])
  @@index([basePrice])
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  path      String
  alt       String
  caption   String?
  sortOrder Int     @default(0)
  width     Int?
  height    Int?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Material {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  type            String
  density         Decimal          @db.Decimal(8, 4)
  pricePerGram    Decimal          @db.Decimal(10, 2)
  description     String?
  advantages      String?
  disadvantages   String?
  temperature     String?
  image           String?
  title           String?
  metaDescription String?
  active          Boolean          @default(true)
  products        Product[]
  colors          Color[]
  variants        ProductVariant[]
  orderItems      OrderItem[]
}

model Color {
  id         String           @id @default(cuid())
  name       String
  slug       String           @unique
  hex        String
  image      String?
  stock      Decimal?         @db.Decimal(12, 2)
  active     Boolean          @default(true)
  materials  Material[]
  products   Product[]
  variants   ProductVariant[]
  orderItems OrderItem[]
}

model Technology {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  description     String?
  accuracy        String?
  applications    String?
  image           String?
  title           String?
  metaDescription String?
  active          Boolean     @default(true)
  products        Product[]
  orderItems      OrderItem[]
}

model QualityProfile {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  layerHeightMm   Decimal          @db.Decimal(5, 3)
  speedMultiplier Decimal          @default(1) @db.Decimal(6, 3)
  priceMultiplier Decimal          @default(1) @db.Decimal(6, 3)
  description     String?
  active          Boolean          @default(true)
  products        Product[]
  variants        ProductVariant[]
  orderItems      OrderItem[]
}

model PostProcessOption {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  price       Decimal   @db.Decimal(10, 2)
  leadDays    Int       @default(0)
  description String?
  active      Boolean   @default(true)
  products    Product[]
}

model ProductVariant {
  id               String          @id @default(cuid())
  productId        String
  materialId       String?
  colorId          String?
  qualityProfileId String?
  sku              String          @unique
  price            Decimal         @db.Decimal(12, 2)
  stock            Int             @default(0)
  active           Boolean         @default(true)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  material         Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  color            Color?          @relation(fields: [colorId], references: [id], onDelete: SetNull)
  qualityProfile   QualityProfile? @relation(fields: [qualityProfileId], references: [id], onDelete: SetNull)
  cartItems        CartItem[]

  @@index([productId, active])
}

model CustomerModelFile {
  id           String          @id @default(cuid())
  ownerId      String?
  guestKey     String?
  originalName String
  storedName   String          @unique
  extension    String
  mimeType     String
  sizeBytes    BigInt
  sha256       String
  widthMm      Decimal?        @db.Decimal(12, 3)
  heightMm     Decimal?        @db.Decimal(12, 3)
  depthMm      Decimal?        @db.Decimal(12, 3)
  volumeCm3    Decimal?        @db.Decimal(14, 4)
  watertight   Boolean?
  status       ModelFileStatus @default(UPLOADED)
  analysisNote String?
  createdAt    DateTime        @default(now())
  owner        User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@unique([ownerId, sha256])
  @@index([ownerId, createdAt])
  @@index([guestKey, createdAt])
}

model PriceRule {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  value       Decimal  @db.Decimal(14, 4)
  unit        String
  active      Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  sessionKey String?    @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
}

model CartItem {
  id          String             @id @default(cuid())
  cartId      String
  productId   String?
  variantId   String?
  modelFileId String?
  quantity    Int                @default(1)
  unitPrice   Decimal            @db.Decimal(12, 2)
  config      Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  cart        Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  modelFile   CustomerModelFile? @relation(fields: [modelFileId], references: [id], onDelete: SetNull)
}

model Order {
  id              String              @id @default(cuid())
  number          String              @unique
  userId          String?
  status          OrderStatus         @default(NEW)
  customerName    String
  customerEmail   String
  customerPhone   String
  company         String?
  shippingAddress String?
  customerComment String?
  internalNote    String?
  subtotal        Decimal             @db.Decimal(12, 2)
  deliveryPrice   Decimal             @default(0) @db.Decimal(12, 2)
  discount        Decimal             @default(0) @db.Decimal(12, 2)
  total           Decimal             @db.Decimal(12, 2)
  currency        String              @default("RUB")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payment         Payment?
  shipment        Shipment?
  notifications   OrderNotification[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id               String             @id @default(cuid())
  orderId          String
  productId        String?
  modelFileId      String?
  materialId       String?
  colorId          String?
  technologyId     String?
  qualityProfileId String?
  productName      String
  sku              String?
  quantity         Int                @default(1)
  unitPrice        Decimal            @db.Decimal(12, 2)
  totalPrice       Decimal            @db.Decimal(12, 2)
  configuration    Json?
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  modelFile        CustomerModelFile? @relation(fields: [modelFileId], references: [id], onDelete: SetNull)
  material         Material?          @relation(fields: [materialId], references: [id], onDelete: SetNull)
  color            Color?             @relation(fields: [colorId], references: [id], onDelete: SetNull)
  technology       Technology?        @relation(fields: [technologyId], references: [id], onDelete: SetNull)
  qualityProfile   QualityProfile?    @relation(fields: [qualityProfileId], references: [id], onDelete: SetNull)
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String        @unique
  provider   String
  externalId String?       @unique
  status     PaymentStatus @default(PENDING)
  amount     Decimal       @db.Decimal(12, 2)
  payload    Json?
  paidAt     DateTime?
  updatedAt  DateTime      @updatedAt
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Shipment {
  id          String    @id @default(cuid())
  orderId     String    @unique
  provider    String
  method      String
  tracking    String?
  cost        Decimal   @default(0) @db.Decimal(12, 2)
  payload     Json?
  shippedAt   DateTime?
  deliveredAt DateTime?
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderNotification {
  id        String    @id @default(cuid())
  orderId   String
  channel   String
  recipient String
  template  String
  status    String
  sentAt    DateTime?
  error     String?
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Rubric {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  articles    Article[]
}

model Article {
  id              String            @id @default(cuid())
  rubricId        String
  title           String
  slug            String            @unique
  excerpt         String?
  content         String
  cover           String?
  authorName      String?
  status          PublicationStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  h1              String?
  canonical       String?
  robots          String            @default("index,follow")
  publishedAt     DateTime?
  updatedAt       DateTime          @updatedAt
  createdAt       DateTime          @default(now())
  rubric          Rubric            @relation(fields: [rubricId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
}

model FaqItem {
  id        String   @id @default(cuid())
  scope     String   @default("general")
  scopeId   String?
  question  String
  answer    String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([scope, scopeId, active])
}

model SeoPage {
  id              String   @id @default(cuid())
  path            String   @unique
  title           String
  metaDescription String
  h1              String
  canonical       String?
  robots          String   @default("index,follow")
  ogImage         String?
  schemaTypes     String[]
  content         String?
  updatedAt       DateTime @updatedAt
}

model SeoFilter {
  id              String   @id @default(cuid())
  categoryId      String
  slug            String
  filter          Json
  title           String
  metaDescription String
  h1              String
  content         String?
  canonical       String?
  active          Boolean  @default(true)
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  code      Int      @default(301)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MetaTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  scope       String
  title       String
  description String
  h1          String
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  rating    Int
  author    String
  text      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, approved, createdAt])
}

model ProductFavorite {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model DeliveryMethod {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  basePrice   Decimal @default(0) @db.Decimal(10, 2)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  group     String   @default("general")
  label     String?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
