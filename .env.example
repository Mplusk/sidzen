DATABASE_URL="postgresql://3dprinta:change-me@db:5432/3dprinta?schema=public"
AUTH_SECRET="generate-a-long-random-secret"
# Optional stable encryption key for LK integration secrets; otherwise AUTH_SECRET is used.
# Back up separately. Do not rotate without re-encrypting stored integration credentials.
INTEGRATION_ENCRYPTION_KEY=""
NEXT_PUBLIC_SITE_URL="https://3dprinta.shop"
# Set true only after verifying actual Russian database AND backup placement.
# This is not a declaration of overall 152-FZ compliance.
PERSONAL_DATA_RF_STORAGE_CONFIRMED="false"
UPLOAD_DIR="/app/private-uploads"
MAX_UPLOAD_MB="100"
BOOTSTRAP_ADMIN_EMAIL="admin@3dprinta.shop"
BOOTSTRAP_ADMIN_PASSWORD="change-me-before-production"
PAYMENT_PROVIDER="manual"
# New payments are configured in LK → Delivery and payment → Tochka.
TOCHKA_TOKEN=""
TOCHKA_CUSTOMER_CODE=""
TOCHKA_MERCHANT_ID=""
# Stored settings and a successful read-only check are required to enable checkout.
# Legacy credentials: retain ONLY to reconcile payments created before Tochka.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_VAT_CODE=""
YOOKASSA_TAX_SYSTEM_CODE=""
# Legacy receipt settings; these do not enable new YooKassa checkout.
YOOKASSA_RECEIPT_MODE=""
YOOKASSA_ALLOW_TEST="false"
RESEND_API_KEY=""
# Default false: do not transmit customer data to foreign email processors.
# Enable only after the operator verifies contracts, localization and transfer rules.
RESEND_PERSONAL_DATA_TRANSFER_APPROVED="false"
ORDER_EMAIL_FROM=""
DELIVERY_PROVIDER="manual"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
