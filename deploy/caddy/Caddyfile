sidzen.shop {
    encode zstd gzip
    request_body {
        max_size 105MB
    }
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    @restoring file {
        root /run/sidzen-restore
        try_files maintenance
    }
    route {
        respond @restoring "Магазин временно недоступен. Идёт восстановление данных." 503
        reverse_proxy app:3000 {
            header_up X-Sidzen-Client-IP {remote_host}
        }
    }
}

www.sidzen.shop {
    redir https://sidzen.shop{uri} permanent
}

# сидзэн.рф and www.сидзэн.рф, encoded as IDNA for TLS and DNS.
xn--d1agbwq9e.xn--p1ai, www.xn--d1agbwq9e.xn--p1ai {
    redir https://sidzen.shop{uri} permanent
}
