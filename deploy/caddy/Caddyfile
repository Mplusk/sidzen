3dprinta.shop {
    encode zstd gzip
    request_body {
        max_size 105MB
    }
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    reverse_proxy app:3000
}

www.3dprinta.shop {
    redir https://3dprinta.shop{uri} permanent
}

# BEGIN PrintERP managed
# PrintERP runs in a separate Compose project on the shared Docker network.
erp.3dprinta.shop {
    encode zstd gzip
    reverse_proxy erp-web:8080
}
# END PrintERP managed
